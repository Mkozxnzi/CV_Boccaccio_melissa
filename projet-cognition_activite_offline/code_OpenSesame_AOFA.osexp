---
API: 3
OpenSesame: 4.0.24
Platform: nt
---
set width 1024
set title AOFA
set subject_parity even
set subject_nr 0
set start experiment
set sound_sample_size -16
set sound_freq 48000
set sound_channels 2
set sound_buf_size 1024
set sampler_backend legacy
set round_decimals 2
set mouse_backend legacy
set keyboard_backend legacy
set height 768
set fullscreen no
set form_clicks no
set foreground "#000000"
set font_underline no
set font_size 18
set font_italic False
set font_family mono
set font_bold False
set experiment_path "C:/Users/MelissaB/Documents/Documents/licence/L3/S6/Cognition"
set disable_garbage_collection False
set description "The main experiment item"
set color_backend legacy
set clock_backend legacy
set canvas_backend legacy
set background "#ffffff"

define sketchpad consigne
	set duration keypress
	set description "Affiche les stimuli"
	draw textline center=1 color="#000000" font_bold=no font_family=mono font_italic=no font_size=18 html=yes show_if=True text="Bonjour,<br /><br />Cette étude porte sur l’adaptation de la frappe au clavier.<br />L’expérience se déroulera en deux phases :<br /><br />Phase d’entraînement : 3 phrases pour vous habituer au clavier.<br />Phase expérimentale : 7 textes à recopier (5 phrases courtes et 2 textes longs).<br />Cette procédure sera répétée lors de 3 sessions espacées de 24 heures.<br /><br />Vous devrez recopier les phrases qui s’affichent à l’écran le plus rapidement et le plus précisément possible.<br /><br />Comme vous l’avez peut‑être remarqué, le clavier est configuré en QWERTY.<br /><br />Appuyez sur la touche de votre choix pour commencer l’entraînement.<br /><br />Bonne chance" x=0 y=0 z_index=0

define sequence experiment
	set flush_keyboard yes
	set description "Lance un certain nombre d'éléments en séquence"
	run participant_form True
	run session_form True
	run consigne True
	run training_loop True
	run fin_training_sketchpad True
	run test_loop True
	run fin_sketchpad True

define sketchpad fin_sketchpad
	set duration keypress
	set description "Affiche les stimuli"
	draw textline center=1 color="#000000" font_bold=no font_family=mono font_italic=no font_size=18 html=yes show_if=True text="L'experience est à present terminée<br /><br />Merci <br /><br />A dans 24h si vous êtes à votre 1ère ou 2ème session " x=0 y=0 z_index=0

define sketchpad fin_training_sketchpad
	set duration keypress
	set description "Affiche les stimuli"
	draw textline center=1 color="#000000" font_bold=no font_family=mono font_italic=no font_size=18 html=yes show_if=True text="L’entraînement est terminé.<br /><br />Nous allons maintenant commencer la phase expérimentale. Vos réponses sont désormais enregistrées pour l’analyse.<br /><br />Appuyez sur une touche pour commencer." x=0 y=0 z_index=0

define inline_script metrique_inline_script
	set description "Exécute du code Python"
	___run__
	# Récupération des variables
	# Texte cible 
	target = var.stimulus_text
	
	# Texte tapé par le participant
	typed = var.user_text
	
	# Calcul de la distance de Levenshtein
	def levenshtein(a, b):
	    m, n = len(a), len(b)
	    dp = [[0]*(n+1) for _ in range(m+1)]
	    for i in range(m+1): dp[i][0] = i
	    for j in range(n+1): dp[0][j] = j
	    for i in range(1, m+1):
	        for j in range(1, n+1):
	            cost = 0 if a[i-1] == b[j-1] else 1
	            dp[i][j] = min(dp[i-1][j] + 1,      # suppression
	                           dp[i][j-1] + 1,      # insertion
	                           dp[i-1][j-1] + cost) # substitution
	    return dp[m][n]
	
	
	# Calcul de la distance brute
	dist = levenshtein(target, typed)
	var.levenshtein_distance = dist
	
	# Score d’erreur final
	error_score = dist / max(1, len(target))
	var.error_score = error_score
	
	# Temps de frappe
	typing_time_ms = clock.time() - var.start_time
	typing_time_min = typing_time_ms / 60000.0
	var.typing_time = typing_time_ms
	
	# Vitesse en caractères/minute (CPM)
	cpm = len(typed) / typing_time_min if typing_time_min > 0 else 0
	var.cpm = cpm
	
	# Vitesse en mots/minute (WPM)
	# Convention : 1 mot = 5 caractères
	wpm = (len(typed) / 5) / typing_time_min if typing_time_min > 0 else 0
	var.wpm = wpm
	
	# Score de précision (%)
	accuracy = max(0, 1 - error_score) * 100
	var.accuracy = accuracy
	
	# Score de fluidité
	# Fluidité = vitesse * précision
	# Normalisé pour rester lisible
	fluency = (wpm * (accuracy / 100))
	var.fluency = fluency
	__end__
	set _prepare ""

define form_text_input participant_form
	set timeout infinite
	set spacing 10
	set rows "1;1;6"
	set only_render no
	set margins "50;50;50;50"
	set form_var participant_id
	set form_title "info participant"
	set form_question "Entrez votre numéro de participant "
	set description "A simple text input form"
	set cols 1
	set _theme gray
	widget 0 0 1 1 label text="{form_title}"
	widget 0 1 1 1 label center=no text="{form_question}"
	widget 0 2 1 1 text_input focus=yes return_accepts=yes stub="" var="{form_var}"


define form_text_input session_form
	set timeout infinite
	set spacing 10
	set rows "1;1;6"
	set only_render no
	set margins "50;50;50;50"
	set form_var session_nr
	set form_title "session info"
	__form_question__
	Entrez le numéro de session (1, 2 ou 3)
	__end__
	set description "A simple text input form"
	set cols 1
	set _theme gray
	widget 0 0 1 1 label text="{form_title}"
	widget 0 1 1 1 label center=no text="{form_question}"
	widget 0 2 1 1 text_input focus=yes return_accepts=yes stub="" var="{form_var}"


define inline_script start_timer
	set description "Exécute du code Python"
	___run__
	var.start_time = clock.time()
	__end__
	set _prepare ""

define form_text_input test_form_text_input
	set timeout infinite
	set spacing 10
	set rows "1;1;6"
	set only_render no
	set margins "50;50;50;50"
	set form_var user_text
	set form_title Test
	set form_question "[stimulus_text]"
	set description "A simple text input form"
	set cols 1
	set _theme gray
	widget 0 0 1 1 label text="{form_title}"
	widget 0 1 1 1 label center=no text="{form_question}"
	widget 0 2 1 1 text_input focus=yes return_accepts=yes stub="" var="{form_var}"


define logger test_logger
	set description "Enregistre les données expérimentales"
	set auto_log yes
	log participant_id
	log session_nr
	log stimulus_text
	log user_text
	log typing_time
	log levenshtein_distance
	log error_score
	log accuracy
	log cpm
	log wpm
	log fluency

define loop test_loop
	set source_file ""
	set source table
	set repeat 1
	set order random
	set description "Exécute à plusieurs reprises un autre élément"
	set cycles 7
	set continuous no
	set break_if_on_first yes
	set break_if False
	setcycle 0 stimulus_text "le soleil brille"
	setcycle 1 stimulus_text "les arbres sont verts"
	setcycle 2 stimulus_text "il fait très froid aujourd’hui"
	setcycle 3 stimulus_text "je mange une pomme"
	setcycle 4 stimulus_text "la musique est agréable"
	setcycle 5 stimulus_text "voici un texte un peu plus long pour tester la vitesse de frappe"
	setcycle 6 stimulus_text "ce matin je me suis réveillé heureux le printemps est enfin là"
	run test_sequence

define sequence test_sequence
	set flush_keyboard yes
	set description "Lance un certain nombre d'éléments en séquence"
	run start_timer True
	run test_form_text_input True
	run metrique_inline_script True
	run test_logger True

define form_text_input training_form_text_input
	set timeout infinite
	set spacing 10
	set rows "1;1;6"
	set only_render no
	set margins "50;50;50;50"
	set form_var user_text
	set form_title entrainement
	set form_question "[training]"
	set description "A simple text input form"
	set cols 1
	set _theme gray
	widget 0 0 1 1 label text="{form_title}"
	widget 0 1 1 1 label center=no text="{form_question}"
	widget 0 2 1 1 text_input focus=yes return_accepts=yes stub="" var="{form_var}"


define loop training_loop
	set source_file ""
	set source table
	set repeat 1
	set order random
	set description "Exécute à plusieurs reprises un autre élément"
	set cycles 3
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 training "le chat dort sur le canapé"
	setcycle 1 training "il fait beau aujourd’hui"
	setcycle 2 training "j'aime lire le soir "
	run training_sequence

define sequence training_sequence
	set flush_keyboard yes
	set description "Lance un certain nombre d'éléments en séquence"
	run training_form_text_input True

